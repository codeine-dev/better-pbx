{
  "name": "better-pbx",
  "version": "0.0.0",
  "private": true,
  "description": "A PBX in a single Docker image with a modern web UI",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @better-pbx/web dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:e2e": "node -e \"console.log('E2E tests are introduced in Phase 4; no tests to run yet.')\"",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:build": "docker build -t better-pbx:latest .",
    "progress": "node scripts/progress.mjs",
    "progress:check": "node scripts/progress.mjs check",
    "progress:render": "node scripts/progress.mjs render"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  }
}
